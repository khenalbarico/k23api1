<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>K23API.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tabletool.settings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tabletool.settings.json')" />
    <None Update="tabletool.settings.example.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
